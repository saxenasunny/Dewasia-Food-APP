# ---------------------------------------------------------------------------
# Public (browser-exposed) Supabase values.
# Anything prefixed with VITE_ is shipped to the browser. NEVER put a
# service-role key or FCM server credential here.
# Find these in: Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---------------------------------------------------------------------------
# Web Push (VAPID). Generate once with:
#   npx web-push generate-vapid-keys
# The PUBLIC key is browser-exposed (VITE_ prefix). The PRIVATE key must ONLY
# ever be set as a secret in the send-push-notification Edge Function.
# ---------------------------------------------------------------------------
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY

# ---------------------------------------------------------------------------
# Server-side only. Set these with:
#   supabase secrets set ...
# Never prefix them with VITE_ and never commit them.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=  (handled inside Edge Functions automatically)
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# FCM_SERVER_KEY=            (only if using FCM legacy HTTP API)
